# ── Supabase (frontend) ────────────────────────────────────────────────────
# Chiave publishable (pubblica): va impostata in Vercel → Settings →
# Environment Variables e, in locale, nel file .env.
# In un sito statico le variabili NEXT_PUBLIC_* non vengono iniettate
# automaticamente nel browser: il frontend le recupera dall'endpoint
# /.netlify/functions/supabase-config, che le legge dall'ambiente.
NEXT_PUBLIC_SUPABASE_URL=https://yqksdpgkktgppxzdbbgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_2wVMVjaEp492prSm71Uz4Q_LwrBv4CC

# ── Backend Strapi (opzionale, disattivato) ────────────────────────────────
# Lascia vuoto: il sito funziona con Supabase + LocalStorage.
# Se un giorno vuoi riattivare galleria, slot di prenotazione e contatori
# social "live", imposta l'URL pubblico della tua istanza Strapi.
STRAPI_URL=

# ── YouTube Data API (opzionale) ───────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=@woodreads
YOUTUBE_CHANNEL_ID=

# ── Credenziali admin (non committare i valori reali) ─────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ── Hermes / WooDreads AI (server-side, mai nel browser) ─────────────────
# Supabase service role: opzionale ma consigliata per il webhook Hermes.
SUPABASE_SERVICE_ROLE_KEY=
# Token di verifica webhook Meta (lo stesso che inserisci in Meta).
HERMES_VERIFY_TOKEN=
# Firma webhook Meta (opzionale; se impostata, il webhook richiede la firma).
META_APP_SECRET=
# WhatsApp Business Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Instagram Messaging (account Professional collegato a una Pagina).
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
# TikTok Direct Message API / endpoint di invio.
TIKTOK_ACCESS_TOKEN=
TIKTOK_SEND_URL=
TIKTOK_BUSINESS_ID=
TIKTOK_WEBHOOK_SECRET=
# AI provider (OpenRouter/OpenAI compatibile).
HERMES_AI_API_KEY=
HERMES_AI_BASE_URL=https://openrouter.ai/api/v1
HERMES_AI_MODEL=
# URL pubblico usato per costruire i webhook mostrati nel pannello.
PUBLIC_SITE_URL=https://www.woodreads.com
META_API_VERSION=v21.0
